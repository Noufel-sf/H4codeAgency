{
  "name": "h4codeagency",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:css": "node -e \"const postcss = require('postcss'); const tailwind = require('@tailwindcss/postcss'); const fs = require('fs'); const css = fs.readFileSync('src/app/globals.css', 'utf8'); postcss([tailwind()]).process(css, { from: 'src/app/globals.css' }).then(res => fs.writeFileSync('src/app/compiled.css', res.css));\"",
    "dev": "pnpm build:css && next dev --webpack",
    "build": "pnpm build:css && next build --webpack",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.6",
    "clsx": "^2.1.1",
    "framer-motion": "^14.12.0",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "next-intl": "^4.15.1",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.92.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "postcss": "^8.5.32",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.32.1"
}
